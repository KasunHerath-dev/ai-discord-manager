# Server configuration
PORT=8787
HOST=127.0.0.1

# Data directory (optional, defaults to .local-data)
# DATA_DIR=.local-data

# Discord API rate-limit handling
# Delay (ms) between successful mutation requests
DISCORD_REQUEST_DELAY_MS=1500

# Maximum retry attempts per operation
DISCORD_MAX_RETRIES=8

# Maximum exponential backoff delay (ms)
DISCORD_MAX_BACKOFF_MS=30000

# Safety buffer after rate-limit response (ms)
DISCORD_RETRY_BUFFER_MS=500

